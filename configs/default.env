# Configuración base para Ryzen 5 5500U + Radeon Vega 7 + 16 GB RAM
MODEL="models/v1-5-pruned-emaonly.safetensors"
WIDTH=512
HEIGHT=512
STEPS=20
CFG_SCALE=7
SEED=42
NEGATIVE_PROMPT=""
SAMPLING_METHOD="euler_a"
LORA_DIR="loras"
LORA_APPLY_MODE="immediately"
VAE_TILING=1
BACKEND="clip=cpu,vae=vulkan0,diffusion=vulkan0"
OUTPUT_DIR="outputs"

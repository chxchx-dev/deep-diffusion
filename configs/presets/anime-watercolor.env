# Preset público de ejemplo para un personaje anime ficticio claramente adulto.
PRESET_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${PRESET_CONFIG_DIR}/default.env"

WIDTH=512
HEIGHT=512
STEPS=20
CFG_SCALE=7
SEED=42
NEGATIVE_PROMPT="low quality, blurry, bad anatomy, malformed hands, extra fingers, duplicate, cropped, text, watermark, signature"
SAMPLING_METHOD="euler_a"
LORA_APPLY_MODE="immediately"
VAE_TILING=1
BACKEND="clip=cpu,vae=vulkan0,diffusion=vulkan0"
